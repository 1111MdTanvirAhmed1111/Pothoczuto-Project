// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  email       String     @unique
  password    String
  role        Role       @default(USER)
  profilePic  String     @default("")
  coverPic    String     @default("")
  friends     User[]     @relation("Friends") // Removed references: [id]
  friendOf    User[]     @relation("Friends")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    Comment[]  // Relation to comments created by this user
  replies     Reply[]    // Relation to replies created by this user
  chatsFrom   Chatting[] @relation("FromUser")
  chatsTo     Chatting[] @relation("ToUser")
}

enum Role {
  USER
  WRITER
  ADMIN
}

model Post {
  id        String    @id @default(uuid())
  title     String
  content   String
  author    String?
  imageUrl  String?   @default("null")
  category  String?
  date      DateTime  @default(now())
  comments  Comment[] // Relation to comments on this post
}

model Comment {
  id         String    @id @default(uuid())
  blogId     String
  text       String
  createdBy  String?   // References User.id
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  replies    Reply[]   // One-to-many relation to replies
  likes      String[]  @default([]) // Array of user IDs who liked
  post       Post      @relation(fields: [blogId], references: [id])
  user       User?     @relation(fields: [createdBy], references: [id])
}

model Reply {
  id         String    @id @default(uuid())
  text       String
  createdAt  DateTime  @default(now())
  createdBy  String?   // References User.id
  commentId  String
  comment    Comment   @relation(fields: [commentId], references: [id])
  user       User?     @relation(fields: [createdBy], references: [id])
  likes      String[]  @default([]) // Array of user IDs who liked
}

model Chatting {
  id        String    @id @default(uuid())
  from      String    // References User.id
  to        String    // References User.id
  messages  Message[] // One-to-many relation to messages
  createdAt DateTime  @default(now())
  userFrom  User      @relation("FromUser", fields: [from], references: [id])
  userTo    User      @relation("ToUser", fields: [to], references: [id])
}

model Message {
  id         String    @id @default(uuid())
  messager   String    // Who sent the message (User ID)
  content    String
  chatting   Chatting  @relation(fields: [chattingId], references: [id])
  chattingId String
}