datasource db {
     provider = "mysql" 
     url      = env("DATABASE_URL")
   }

   generator client {
     provider = "prisma-client-js"
    binaryTargets   = ["native", "debian-openssl-1.0.x"]
   }

model posts {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String
  imageUrl  String
  category  String
  date      DateTime @default(now())
}